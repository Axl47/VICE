  },

  "phases": {
    "_comment": "Shares must sum to 1.0. Curves are smoothstep unless noted. Onset carries zero amplitude by design so the first frame of the effect shows nothing.",
    "order": ["onset", "comeUp", "peak", "plateau", "comeDown", "afterglow"],
    "weights": {
      "onset": 0.10,
      "comeUp": 0.15,
      "peak": 0.20,
      "plateau": 0.30,
      "comeDown": 0.20,
      "afterglow": 0.05
    },
    "amplitude": {
      "onset": 0.0,
      "comeUp": 0.55,
      "peak": 1.0,
      "plateau": 0.88,
      "comeDown": 0.42,
      "afterglow": 0.12
    },
    "channelBias": {
      "_comment": "Per-phase multiplier per channel. 1.0 means 'follows the global amplitude'. Keeps trails/echo tailing into comedown without inventing periodicity.",
      "onset":     { "trails": 0.0, "afterimage": 0.0, "reverbWet": 0.2, "echo": 0.0 },
      "comeUp":    { "trails": 0.4, "afterimage": 0.3, "reverbWet": 0.6, "echo": 0.3 },
      "peak":      { "trails": 1.0, "afterimage": 1.0, "reverbWet": 1.0, "echo": 1.0 },
      "plateau":   { "trails": 0.9, "afterimage": 0.95, "reverbWet": 0.9, "echo": 0.85 },
      "comeDown":  { "trails": 0.7, "afterimage": 0.8, "reverbWet": 1.0, "echo": 0.7 },
      "afterglow": { "trails": 0.5, "afterimage": 0.6, "reverbWet": 0.8, "echo": 0.5 }
    },
    "noise": {
      "_comment": "Low-amplitude Perlin noise added to every phase curve, to remove any periodic feel.",
      "amplitude": 0.06,
      "frequency": 0.9
    },
    "tripVariation": 0.12
  }
}
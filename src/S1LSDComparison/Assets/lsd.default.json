{
  "_comment": "S1LSD default tuning, embedded in the DLL. Put only the values you want to change in UserData/S1LSD/lsd.json. Per-style visual limits live in Core/VisualMixer.cs. See docs/CONFIG.md.",

  "schemaVersion": 2,

  "quality": {
    "_comment": "visualStyle: 'classic' (strong, default) or 'subtle' (straight lines stay straight). gentleMode lowers everything heavy. maxFlickerHz caps how fast brightness/colour may change (max 3). customShaders: S1LSD's perception shader (texture-aware crawl, trails, patterns in the dark); false = post-processing only.",
    "visualStyle": "classic",
    "visualIntensityScale": 1.0,
    "gentleMode": false,
    "maxFlickerHz": 3.0,
    "customShaders": true,
    "firstLaunchWarningShown": false
  },

  "patches": {
    "_comment": "One switch per game patch. Turn one off if it conflicts with another mod; the rest of S1LSD keeps working. See docs/CONFIG.md.",
    "stationRecipeGuard": true,
    "productManagerGuard": true,
    "discoveryHooks": true,
    "packagingIcons": true,
    "npcConsume": true,
    "customerAffinity": true,
    "itemModels": true
  },

  "audio": {
    "_comment": "Listener filters and procedural ambience. Transitions take transitionSeconds. Echo/chorus are kept subtle on purpose; see docs/CONFIG.md.",
    "filterIntensity": 1.0,
    "ambienceVolume": 0.6,
    "transitionSeconds": 3.0,
    "reverbMaxRoomMb": -900.0,
    "echoDelayMs": [180.0, 350.0],
    "echoDecay": [0.25, 0.40],
    "echoMaxWet": 0.35,
    "chorusMaxWet": 0.15,
    "lowPassMinHz": 9000.0,
    "closedEyesLowPassHz": 6000.0,
    "badTripLowPassHz": 3500.0,
    "useGameDistortedSnapshot": false
  },

  "breath": {
    "_comment": "Irregular oscillator shared by the visual breathing (lens, FOV, crawl) and the audio dips.",
    "baseHz": 0.22,
    "perlinOctaves": 3,
    "perlinFrequency": 0.55,
    "depth": 0.35
  },

  "tolerance": {
    "_comment": "T in [0,1]. See docs/CONFIG.md for formulas.",
    "enabled": true,
    "baseGain": 0.35,
    "referenceDose": 140.0,
    "gainExponent": 0.5,
    "maxReduction": 0.8,
    "durationReductionMax": 0.2,
    "halfLifeGameDays": 2.0
  },

  "badTrip": {
    "_comment": "chanceByDose is rolled at consumption and plants a wave of anxiety (not an instant bad trip); the setting (useSetting) and mindful breathing decide whether it tips into an episode. durationMinutes is the longest an episode lasts, minDurationMinutes the shortest without breathing.",
    "enabled": true,
    "chanceByDose": {
      "70": 0.02,
      "140": 0.04,
      "280": 0.07,
      "360": 0.12
    },
    "durationMinutes": 6.0,
    "minDurationMinutes": 2.0,
    "endOnSleep": true,
    "tunnelPeak": 0.85,
    "blendSeconds": 20.0,
    "warpMultiplier": 1.6,
    "haloMultiplier": 1.4,
    "colorDriftMultiplier": 1.8,
    "moveSpeedScale": 0.72,
    "useSetting": true,
    "cooldownMinutes": 3.0
  },

  "gameplay": {
    "_comment": "Penalties only apply at 280 and 360, per spec.",
    "controlPenaltyDoses": [280, 360],
    "controlPenaltyMoveSpeed": 0.86,
    "closedEyesKey": "B",
    "mindfulBreathingKey": "V",
    "proceduralIcons": true,
    "consumeFeedback": true,
    "customModel": true,
    "useEatAnimation": true
  },

  "economy": {
    "_comment": "Production, trading and sale through the game's own systems. Ingredients are abstract in-game items only.",
    "recipeEnabled": true,
    "recipeId": "s1lsd:lsd-synthesis",
    "recipeTitle": "LSD Crystals",
    "cookTimeMinutes": 240,
    "temperatureC": 190,
    "temperatureTolerance": 20,
    "finalLiquidColor": "#3F5FA8",
    "ingredients": [
      { "itemId": "megabean", "quantity": 1 },
      { "itemId": "acid", "quantity": 1 }
    ],
    "yieldDose": 70,
    "yieldQuantity": 4,
    "discoverOnFirstCraft": true,
    "listForSaleOnDiscover": false,
    "shopsEnabled": true,
    "_shopNamesComment": "Display names of existing supplier shops. The mod logs the real shop names present in the world on every launch, so this list can be corrected from the log rather than guessed.",
    "shopNames": [],
    "shopStock": { "70": 2, "140": 2, "280": 1, "360": 1 }
  },


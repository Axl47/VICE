      "subtleBlend": 0.008,
      "subtleAmplitude": 0.12,
      "subtleNoiseScale": 65.0,
      "peaks": {
        "warp": 0.30, "trails": 0.25, "halo": 0.30, "chroma": 0.15,
        "colorDrift": 0.40, "localContrast": 0.40, "afterimage": 0.10,
        "patterns": 0.35, "reverbWet": 0.20, "echo": 0.10,
        "pitchDrift": 0.15, "lfPulse": 0.15,
        "textureCrawl": 0.30, "pupil": 0.30, "synesthesia": 0.20, "closedEyes": 0.00
      }
    },
    "280": {
      "displayName": "Acid 280",
      "price": 124,
      "durationMinutes": 8.5,
